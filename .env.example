# Environment Configuration
NODE_ENV=development

# FundedNext API
FUNDEDNEXT_API_KEY=your_fundednext_api_key_here
FUNDEDNEXT_ACCOUNT_ID=your_account_id_here

# Groq API (free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: let Groq review each strategy signal before execution
AI_REVIEW_ENABLED=false
AI_MIN_CONFIDENCE=0.55

# Market Data API (if using external provider)
MARKET_DATA_API_KEY=your_market_data_api_key_here

# Trading Configuration
ACCOUNT_BALANCE=6000
RISK_PER_TRADE=30
TARGET_PROFIT=300
MAX_DAILY_LOSS=100
MAX_TRADES_PER_DAY=3
SAFETY_BUFFER=70

# Database
DB_PATH=./data/trades.db
DB_LOG_PATH=./logs/trades.log

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Bot Configuration
BOT_ENABLED=false
DRY_RUN=true
DEBUG=false
# Seconds between scan cycles during the session
CYCLE_INTERVAL_SECONDS=30

# Trading Hours (in BOT_TIMEZONE, independent of server timezone)
BOT_TIMEZONE=Asia/Kolkata
LONDON_OPEN_HOUR=13
LONDON_OPEN_MINUTE=30
LONDON_CLOSE_HOUR=17
LONDON_CLOSE_MINUTE=0

# Risk Management
MIN_ATR_PIPS=50
PROFIT_RATIO=2
MIN_WIN_RATE=0.70

# Dashboard (open http://<server-ip>:3000)
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me
DATA_DIR=./data

# Notification (Optional)
SLACK_WEBHOOK_URL=
EMAIL_RECIPIENT=
