# ───────────────────────── FundedNext Trading Bot (.env) ─────────────────────────
NODE_ENV=production

# ── Market data & execution ──
# sim = offline random-walk feed | mt5 = real prices from the MT5 bridge (Windows EC2)
DATA_SOURCE=sim
# Bridge on the Windows host — use its PRIVATE IP (terraform output bridge_url)
MT5_BRIDGE_URL=http://172.31.0.10:8765
# Same value as SSM /fundednext-bot/bridge_token (terraform output read_secrets)
MT5_BRIDGE_TOKEN=change_me
MT5_MAGIC=260101
MT5_DEVIATION_POINTS=30
# true = paper trades (real MT5 prices, simulated fills). false = REAL orders on the MT5 account.
DRY_RUN=true

# ── Groq AI review (two keys from two accounts; auto-switch on rate limit) ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
AI_REVIEW_ENABLED=true
# closed = no AI answer → no trade (recommended) | open = trade on strategy rules if Groq is down
AI_REVIEW_FAIL_MODE=closed
AI_MIN_CONFIDENCE=0.55
GROQ_MAX_RETRIES=2

# ── Account (FundedNext Stellar 2-Step, $6K) ──
ACCOUNT_BALANCE=6000
# 0.75% of balance per trade = $45 (hard cap 1%)
RISK_PERCENT=0.75
MAX_TRADES_PER_DAY=3
DAILY_LOSS_PERCENT=5
# 6 = 1-Step, 10 = 2-Step, 8 = Lite
MAX_LOSS_PERCENT=10
# Phase 1 target 8%, Phase 2 target 5%
CHALLENGE_PHASE=1
MIN_TRADING_DAYS_PER_PHASE=5
PHASE_START_DATE=2026-10-23
# FundedNext rule: never close a trade under 30 seconds
MIN_TRADE_DURATION_SECONDS=30

# ── Strategy ── (compare first: npm run backtest -- --strategies)
# breakout | trendPullback | asianBreakout | meanReversion | emaCross | donchian
STRATEGY=breakout
# Entry candles: H1 | M30 | M15
ENTRY_TIMEFRAME=H1
# rolling24h = last RANGE_HOURS of closed candles | prevDay = broker's previous D1 candle
RANGE_MODE=rolling24h
RANGE_HOURS=24
# breakout only: require the price-action filter to agree
USE_PRICE_ACTION=true
# TP = PROFIT_RATIO × SL distance (1–5)
PROFIT_RATIO=2
# Gold: 1 pip = 0.1 ($0.10). ATR minimum on the entry timeframe (H1 ≈ 50, M15 ≈ 25)
MIN_ATR_PIPS=50
# Stop distance clamped between these multiples of ATR
SL_MIN_ATR=0.5
SL_MAX_ATR=1.5
MAX_SPREAD_PIPS=8

# ── Session (London time — DST handled automatically) ──
# 08:00–11:30 London = 13:30–17:00 IST in winter, 12:30–16:00 IST in summer
SESSION_TIMEZONE=Europe/London
SESSION_START=08:00
SESSION_END=11:30
# Timezone for logs, dashboard and the daily reset
BOT_TIMEZONE=Asia/Kolkata

# ── Bot ──
BOT_ENABLED=true
CYCLE_INTERVAL_SECONDS=30
LOG_LEVEL=info
LOG_DIR=./logs
DATA_DIR=./data
# Simulated feed only: >1 = bigger fake swings for faster testing
SIM_VOLATILITY=1

# ── Dashboard ──
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me

# ── Alerts (Telegram: talk to @BotFather → token; send your bot a message → chat id from
#    https://api.telegram.org/bot<TOKEN>/getUpdates) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
