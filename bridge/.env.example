# MT5 bridge config (Windows). Copy to bridge/.env — never commit the real file.
# The bootstrap script fills this from AWS SSM Parameter Store automatically.

# Shared secret; the Node bot sends it as "Authorization: Bearer <token>"
BRIDGE_TOKEN=change_me_long_random_string

# FundedNext MT5 login (demo / free trial)
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=FundedNext-Server3

# Optional: full path to terminal64.exe (needed when several terminals are installed)
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

ALLOWED_SYMBOLS=XAUUSD
MT5_MAGIC=260101
BRIDGE_LOG_LEVEL=INFO

# 1 = run without MT5 (fake prices) for testing on Linux/CI
BRIDGE_MOCK=0
